# YarnGPT hosted API key (https://yarngpt.ai/api-docs).
# Required ONLY to run `make prerender-audio` (voice/generate_prompts.py), which
# pre-renders every spoken phrase to a local cache. Never required at kiosk
# runtime — the kiosk only ever plays cached audio, never calls this API live.
YARNGPT_API_KEY=

# PBKDF2-SHA256 hash of the admin dashboard PIN, formatted "<b64 salt>:<hex hash>".
# Never store the raw PIN. Generate one with:
#   python -c "import os,hashlib,base64; salt=os.urandom(16); pin=input('PIN: '); print(base64.b64encode(salt).decode()+':'+hashlib.pbkdf2_hmac('sha256', pin.encode(), salt, 200_000).hex())"
ADMIN_PIN_HASH=

# Optional: force a specific onnxruntime execution provider
# (CUDAExecutionProvider | CPUExecutionProvider). Unset = auto-detect, prefers CUDA.
ONNX_PROVIDER=

# Optional: override the SQLite DB path (defaults to ./voter_kiosk.db)
VOTER_KIOSK_DB_PATH=
